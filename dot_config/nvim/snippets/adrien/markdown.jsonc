{
	// Place your snippets for markdown here. Each snippet is defined under a snippet name and has a prefix, body and
	// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the
	// same ids are connected.
	// Example:
	"Note": {
		"prefix": "note",
		"body": ["> [!NOTE]", "> $1", ""],
		"description": "Note alert"
	},
	"Tip": {
		"prefix": "tip",
		"body": ["> [!TIP]", "> $1", ""],
		"description": "Tip alert"
	},
	"Important": {
		"prefix": "important",
		"body": ["> [!IMPORTANT]", "> $1", ""],
		"description": "Important alert"
	},
	"Warning": {
		"prefix": "warning",
		"body": ["> [!WARNING]", "> $1", ""],
		"description": "Warning alert"
	},
	"Caution": {
		"prefix": "caution",
		"body": ["> [!CAUTION]", "> $1", ""],
		"description": "Caution alert"
	},
	"WIP": {
		"prefix": "wip",
		"body": [
			"> [!WARNING]",
			"> This project is currently work in progress...",
			""
		],
		"description": "WIP Flag"
	},
	"List checkbox": {
		"prefix": "lc",
		"body": ["- [ ] "],
		"description": "List checkbox"
	},
	"List checkbox checked": {
		"prefix": "lcc",
		"body": ["- [X] "],
		"description": "List checkbox but checked"
	},
	"Right arrow": {
		"body": "$\\rightarrow$",
		"prefix": "rarr"
	},
	"Left right arrow": {
		"body": "$\\Leftrightarrow$",
		"prefix": "lra"
	},
	"Neq": {
		"body": "$\\neq$",
		"prefix": "neq"
	},
	"Indice": {
		"body": "\\$_{$1}$",
		"prefix": "ind"
	}
}
